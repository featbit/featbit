<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="coverlet.MTP" />

        <PackageReference Include="Testcontainers.MongoDb" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="Testcontainers.Redis" />
        <PackageReference Include="Testcontainers.Kafka" />

        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="Confluent.Kafka" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\Streaming\Streaming.csproj" />
        <ProjectReference Include="..\TestBase\TestBase.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The Postgres integration fixture applies the repo's production
            init scripts so store-layer tests run against the real schema.
            Files are embedded so the relative path from this project doesn't
            need to resolve at runtime.
        -->
        <EmbeddedResource Include="..\..\..\..\infra\postgresql\docker-entrypoint-initdb.d\*.sql">
            <LogicalName>FeatBitPostgresInitDb.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
