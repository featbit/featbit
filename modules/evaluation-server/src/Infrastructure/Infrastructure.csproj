<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <AssemblyName>FeatBit.EvaluationServer.Infrastructure</AssemblyName>
        <PackageId>FeatBit.EvaluationServer.Infrastructure</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.Kafka" />
        <PackageReference Include="AspNetCore.HealthChecks.MongoDb" />
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
        <PackageReference Include="AspNetCore.HealthChecks.Redis" />
        <PackageReference Include="Confluent.Kafka" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="Npgsql.DependencyInjection" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="Dapper" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Fakes\flags.json" CopyToOutputDirectory="Always"/>
        <None Update="Fakes\segments.json" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Surface internal members (e.g. RedisClient.EnsureSelfHealingOptions, #106) to unit tests. -->
        <InternalsVisibleTo Include="Infrastructure.UnitTests"/>
    </ItemGroup>

</Project>
