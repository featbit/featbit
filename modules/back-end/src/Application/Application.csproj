<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <!-- Every view model member must be mapped or explicitly ignored (see Bases/Mapping/MapperDefaults.cs). -->
        <WarningsAsErrors>$(WarningsAsErrors);RMG012</WarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--  Any version prior to MediatR v13.0 remains free under its original open-source license.   -->
        <!--  We will remove this dependency in the future.  -->
        <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="MediatR" />

        <PackageReference Include="FluentValidation" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" />
    </ItemGroup>

</Project>
